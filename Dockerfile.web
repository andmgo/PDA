# gescazone-web (Spring Boot + Thymeleaf). Contexto de build: carpeta GESCAZONE/.
FROM maven:3.9.6-eclipse-temurin-21 AS build
WORKDIR /app
COPY web/pom.xml .
RUN mvn -q dependency:go-offline
COPY web/src ./src
RUN mvn -q clean package -DskipTests

FROM eclipse-temurin:21-jre
WORKDIR /app
COPY --from=build /app/target/gescazone-web-*.jar app.jar
ENV JAVA_TOOL_OPTIONS="-XX:MaxRAMPercentage=70 -XX:+UseSerialGC -Xss512k"
EXPOSE 8081
ENTRYPOINT ["sh", "-c", "exec java -jar app.jar --server.port=${PORT:-8081}"]
